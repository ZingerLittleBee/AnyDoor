# Apple notarization credentials.
APPLE_ID="your-apple-id@example.com"
APPLE_TEAM_ID="YOURTEAMID"

# Only needed while creating the notarytool keychain profile. Leave empty after
# credentials are stored in Keychain.
APPLE_APP_SPECIFIC_PASSWORD=""

# notarytool keychain profile used by scripts/release.sh.
NOTARY_PROFILE="AnyDoor-Notary"

# Release signing configuration.
SIGNING_IDENTITY="Developer ID Application: Your Name (YOURTEAMID)"
REPO_URL="https://github.com/your-org/your-repo"
