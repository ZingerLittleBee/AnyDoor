DEFINE SCHEMA

    RECORD TYPE Users (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        roles           LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );

    RECORD TYPE ClipboardSyncControlV1 (
        "___createTime"  TIMESTAMP,
        "___createdBy"   REFERENCE,
        "___etag"        STRING,
        "___modTime"     TIMESTAMP,
        "___modifiedBy"  REFERENCE,
        "___recordID"    REFERENCE,
        protocolVersion  INT64,
        accountID        STRING,
        keyID            STRING,
        keyCheck         BYTES,
        epoch            STRING,
        phase            STRING,
        commitMarker     STRING
    );

    RECORD TYPE ClipboardSyncObjectV1 (
        "___createTime"  TIMESTAMP,
        "___createdBy"   REFERENCE,
        "___etag"        STRING,
        "___modTime"     TIMESTAMP,
        "___modifiedBy"  REFERENCE,
        "___recordID"    REFERENCE,
        metadata         BYTES
    );

    RECORD TYPE ClipboardSyncChunkV1 (
        "___createTime"  TIMESTAMP,
        "___createdBy"   REFERENCE,
        "___etag"        STRING,
        "___modTime"     TIMESTAMP,
        "___modifiedBy"  REFERENCE,
        "___recordID"    REFERENCE,
        operationID      STRING,
        epoch            STRING,
        keyID            STRING,
        chunkIndex       INT64,
        chunkDigest      BYTES,
        asset            ASSET
    );
