---
// § 01: why AnyDoor, laid out as a three-column datasheet.
import Bi from './Bi.astro';
import { why } from '../lib/content/hero';
---

<section class="sec wrap" id="why">
  <div class="sec-rule"><span class="lbl">§ 01 · <Bi text={why.eyebrow} /></span><span class="lbl">S-01 – S-03</span></div>
  <div class="sec-head">
    <h2 class="h2"><span class="ln"><Bi text={why.h2a} /></span><span class="ln"><Bi text={why.h2b} /></span></h2>
    <p class="lede"><Bi text={why.lede} /></p>
  </div>
  <div class="sheet">
    {why.columns.map((c, i) => (
      <article class="sheet-col">
        <div class="sheet-no"><span class="n">0{i + 1}</span><span class="lbl">S-0{i + 1}</span></div>
        <h3><Bi text={c.title} /></h3>
        <p><Bi text={c.desc} /></p>
        <div class="sheet-val"><Bi text={c.vs} /></div>
      </article>
    ))}
  </div>
</section>

<style>
  .sheet { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--ink); border-bottom: 1px solid var(--rule); }
  .sheet-col { padding: 26px clamp(18px, 2.2vw, 30px) 30px; display: flex; flex-direction: column; gap: 14px; min-width: 0; }
  .sheet-col + .sheet-col { border-left: 1px solid var(--rule); }
  .sheet-no { display: flex; justify-content: space-between; align-items: baseline; }
  .sheet-no .n { font: 300 44px/1 var(--mono); color: var(--ink); letter-spacing: -0.04em; }
  .sheet-col h3 { font-size: 21px; line-height: 1.3; font-weight: 600; letter-spacing: -0.01em; }
  .sheet-col p { font-size: 15px; line-height: 1.65; color: var(--ink-2); text-wrap: pretty; }
  :global(html[data-lang="zh"]) .sheet-col p { line-height: 1.8; }
  .sheet-val { margin-top: auto; padding-top: 14px; border-top: 1px dashed var(--rule); font: 500 12px/1.3 var(--mono); color: var(--ink); display: flex; align-items: center; gap: 8px; }
  .sheet-val::before { content: ""; width: 8px; height: 8px; background: var(--sig); border-radius: 2px; flex: none; }

  @media (max-width: 820px) {
    .sheet { grid-template-columns: minmax(0, 1fr); }
    .sheet-col + .sheet-col { border-left: 0; border-top: 1px solid var(--rule); }
  }
</style>
