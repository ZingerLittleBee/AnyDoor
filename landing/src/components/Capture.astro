---
import { icons } from '../lib/icons';
import { copy } from '../lib/copy';
import Bi from './Bi.astro';

// Attached selection toolbar — the five capture tools, region active first.
const tools = [
  { key: 'crop',        label: copy.capture.toolRegion },
  { key: 'windowFrame', label: copy.capture.toolWindow },
  { key: 'fullscreen',  label: copy.capture.toolFull },
  { key: 'scroll',      label: copy.capture.toolScroll },
  { key: 'video',       label: copy.capture.toolRecord },
] as const;
---

<section class="section container-x" id="capture">
  <div class="eyebrow">
    <span class="dot" style="background: var(--color-mac-green); box-shadow: 0 0 12px var(--color-mac-green)" />
    <Bi text={copy.capture.eyebrow} />
  </div>
  <h2 class="sec-h">
    <span class="gradient-text"><Bi text={copy.capture.h2a} /></span><br />
    <span class="accent-text"><Bi text={copy.capture.h2b} /></span>
  </h2>
  <p class="lede"><Bi text={copy.capture.lede} /></p>

  {/* ── Hero: frozen desktop + draggable selection + attached toolbar ── */}
  <div class="cap-hero">
    <div class="cap-screen" aria-hidden="true">
      {/* Faux desktop behind the spotlight */}
      <div class="cap-menubar">
        <span class="cap-mb-apple" set:html={icons.command()} />
        <span class="cap-mb-i" style="width:42px"></span>
        <span class="cap-mb-i" style="width:30px"></span>
        <span class="cap-mb-sp"></span>
        <span class="cap-mb-i" style="width:22px"></span>
        <span class="cap-mb-i" style="width:18px"></span>
        <span class="cap-mb-i" style="width:54px"></span>
      </div>
      <div class="cap-win cap-win-a">
        <div class="cap-win-bar"><i class="tl r"></i><i class="tl y"></i><i class="tl g"></i></div>
        <div class="cap-win-body">
          <span class="ln" style="width:64%"></span>
          <span class="ln" style="width:88%"></span>
          <span class="ln" style="width:52%"></span>
          <span class="ln" style="width:74%"></span>
        </div>
      </div>
      <div class="cap-win cap-win-b">
        <div class="cap-win-bar"><i class="tl r"></i><i class="tl y"></i><i class="tl g"></i></div>
        <div class="cap-win-grid">
          <span></span><span></span><span></span><span></span><span></span><span></span>
        </div>
      </div>
      <div class="cap-dock">
        <span></span><span></span><span></span><span></span><span></span><span></span><span></span>
      </div>

      {/* Spotlight selection — box-shadow darkens everything outside it */}
      <div class="cap-selection">
        <span class="cap-dimbadge"><Bi text={copy.capture.badge} /> · 1280 × 720</span>
        <i class="hd tl"></i><i class="hd tc"></i><i class="hd tr"></i>
        <i class="hd ml"></i><i class="hd mr"></i>
        <i class="hd bl"></i><i class="hd bc"></i><i class="hd br"></i>

        {/* Attached toolbar */}
        <div class="cap-toolbar">
          {tools.map((t, i) => (
            <button class={`cap-tool${i === 0 ? ' is-on' : ''}`} type="button" tabindex="-1">
              <span class="cap-hl"></span>
              <span class="cap-tool-ico" set:html={icons[t.key]()} />
              <span class="cap-tool-lbl"><Bi text={t.label} /></span>
            </button>
          ))}
        </div>
      </div>
    </div>
  </div>

  {/* ── Supporting mocks ── */}
  <div class="cap-grid">
    {/* Interactive scrolling capture */}
    <div class="acard cap-card">
      <div class="cap-card-head">
        <div class="head-ico" style="background:rgba(94,155,255,.15);color:#5e9bff" set:html={icons.scroll()} />
        <h3><Bi text={copy.capture.scrollTitle} /></h3>
      </div>
      <p><Bi text={copy.capture.scrollDesc} /></p>
      <div class="acard-stage sc-stage">
        <div class="sc-readout">
          <span class="sc-rec-dot"></span>
          <Bi text={copy.capture.scrollCaptured} /> <span id="sc-count" class="sc-num">320</span> px
        </div>
        <div class="sc-viewport">
          <div class="sc-strip">
            {Array.from({ length: 14 }).map((_, i) => (
              <div class="sc-block" style={`--w:${52 + ((i * 37) % 44)}%`}>
                <span class="b1"></span><span class="b2"></span>
              </div>
            ))}
          </div>
          <div class="sc-scanline"></div>
        </div>
        <div class="sc-bar">
          <button class="sc-btn ghost" type="button" tabindex="-1"><Bi text={copy.capture.scrollCancel} /></button>
          <button class="sc-btn prime" type="button" tabindex="-1"><Bi text={copy.capture.scrollDone} /></button>
        </div>
      </div>
    </div>

    {/* Quick-access overlay */}
    <div class="acard cap-card">
      <div class="cap-card-head">
        <div class="head-ico" style="background:rgba(48,209,88,.15);color:#30d158" set:html={icons.camera()} />
        <h3><Bi text={copy.capture.overlayTitle} /></h3>
      </div>
      <p><Bi text={copy.capture.overlayDesc} /></p>
      <div class="acard-stage qa-stage">
        <div class="qa-shot">
          <div class="qa-shot-bar"><i></i><i></i><i></i></div>
          <div class="qa-shot-body">
            <span class="ln" style="width:70%"></span>
            <span class="ln" style="width:90%"></span>
            <span class="ln" style="width:58%"></span>
          </div>
        </div>
        <div class="qa-overlay">
          <button class="qa-act" type="button" tabindex="-1"><span set:html={icons.clipboard()} /><em><Bi text={copy.capture.overlayCopy} /></em></button>
          <button class="qa-act" type="button" tabindex="-1"><span set:html={icons.save()} /><em><Bi text={copy.capture.overlaySave} /></em></button>
          <button class="qa-act" type="button" tabindex="-1"><span set:html={icons.pencil()} /><em><Bi text={copy.capture.overlayEdit} /></em></button>
          <button class="qa-act" type="button" tabindex="-1"><span set:html={icons.pin()} /><em><Bi text={copy.capture.overlayPin} /></em></button>
          <button class="qa-act" type="button" tabindex="-1"><span set:html={icons.ocr()} /><em>OCR</em></button>
          <span class="qa-sep"></span>
          <button class="qa-act danger" type="button" tabindex="-1"><span set:html={icons.trash()} /></button>
        </div>
      </div>
    </div>

    {/* Screen recording */}
    <div class="acard cap-card">
      <div class="cap-card-head">
        <div class="head-ico" style="background:rgba(255,69,58,.15);color:#ff453a" set:html={icons.video()} />
        <h3><Bi text={copy.capture.recTitle} /></h3>
      </div>
      <p><Bi text={copy.capture.recDesc} /></p>
      <div class="acard-stage rc-stage">
        <div class="rc-cam"><span set:html={icons.video()} /></div>
        <div class="rc-keys"><kbd>⌘</kbd><kbd>⇧</kbd><kbd>5</kbd></div>
        <div class="rc-controls">
          <span class="rc-dot"></span>
          <span class="rc-time" id="rc-time">00:12</span>
          <span class="rc-div"></span>
          <span class="rc-fmt active">MOV</span>
          <span class="rc-fmt">MP4</span>
          <span class="rc-fmt">GIF</span>
          <span class="rc-div"></span>
          <button class="rc-stop" type="button" tabindex="-1"><span set:html={icons.record()} /><Bi text={copy.capture.recStop} /></button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Lightweight, decorative counters — disabled when the user prefers reduced
  // motion. Each ticks a number to suggest live capture / recording.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduce) {
    // Scrolling capture: climb the captured-px readout, loop on completion.
    const count = document.getElementById('sc-count');
    if (count) {
      let px = 320;
      setInterval(() => {
        px = px >= 3840 ? 320 : px + 64;
        count.textContent = String(px).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
      }, 900);
    }
    // Recording: tick the elapsed timer mm:ss.
    const time = document.getElementById('rc-time');
    if (time) {
      let s = 12;
      setInterval(() => {
        s = s >= 599 ? 0 : s + 1;
        const mm = String(Math.floor(s / 60)).padStart(2, '0');
        const ss = String(s % 60).padStart(2, '0');
        time.textContent = `${mm}:${ss}`;
      }, 1000);
    }
  }
</script>
