---
// § 03: the capture suite. A frozen-screen stage with the selection toolbar,
// plus scrolling capture, the quick-access overlay, and screen recording.
import Bi from './Bi.astro';
import { biAttrs } from '../lib/i18n';
import {
  FRAME_SLOTS,
  capture as t,
  captureDims,
  captureInitial as init,
  captureOverlay,
  captureSelections,
  captureTools,
  formatClock,
} from '../lib/content/studio';

const sel = captureSelections[init.tool];
const shownFrames = Math.min(init.frames, FRAME_SLOTS);
const clock = formatClock(init.recSec);
const recState = init.recOn ? 'on' : 'off';
---

<section class="sec wrap" id="capture">
  <div class="sec-rule"><span class="lbl">§ 03 · <Bi text={t.eyebrow} /></span><span class="lbl">C-01 – C-04</span></div>
  <div class="sec-head">
    <h2 class="h2"><span class="ln"><Bi text={t.h2a} /></span><span class="ln"><Bi text={t.h2b} /></span></h2>
    <p class="lede"><Bi text={t.lede} /></p>
  </div>
  <div class="cap-grid">
    <article class="plate stage-plate">
      <div class="plate-hd"><span class="pn">C-01</span><span class="nm"><Bi text={t.toolbarName} /></span></div>
      <div class="plate-bd">
        <div class="stage striped">
          <span class="badge"><Bi text={t.badge} /></span>
          <span class="ph-lbl"><Bi text={t.phLabel} /></span>
          <div class="fakewin" aria-hidden="true"><div class="bar"><i></i><i></i><i></i></div><div class="lines"><i></i><i></i><i></i><i></i><i></i></div></div>
          <div
            class:list={['capsel', init.tool === 'full' && 'full']}
            style={`--x: ${sel.x}; --y: ${sel.y}; --w: ${sel.w}; --h: ${sel.h}`}
            data-capsel
          >
            <span class="hd hA"></span><span class="hd hB"></span><span class="hd hC"></span><span class="hd hD"></span>
            <span class="dims" data-dims>{captureDims(init.tool)}</span>
            <span class="rec" data-rec-badge hidden={init.tool !== 'record'}><span>REC <span data-clock>{clock}</span></span></span>
          </div>
          <div class="toolbar" role="group" {...biAttrs({ 'aria-label': t.toolbarName })}>
            {captureTools.map((o) => (
              <button
                type="button"
                class:list={['tool', init.tool === o.id && 'on']}
                aria-pressed={String(init.tool === o.id)}
                data-tool={o.id}
                {...biAttrs({ 'aria-label': o.label })}
              ><span class="g">{o.glyph}</span><span class="lb"><Bi text={o.label} /></span></button>
            ))}
          </div>
        </div>
      </div>
    </article>
    <div class="cap-side">
      <article class="plate">
        <div class="plate-hd"><span class="pn">C-02</span><span class="nm"><Bi text={t.scrollTitle} /></span></div>
        <div class="plate-bd">
          <p class="desc"><Bi text={t.scrollDesc} /></p>
          <div class="stitch">
            <div class="frames" aria-hidden="true">
              {Array.from({ length: FRAME_SLOTS }, (_, i) => (
                <i class:list={[i === shownFrames - 1 && 'cur']} hidden={i >= shownFrames}></i>
              ))}
            </div>
            <div class="smeta">
              <span class="count"><span data-frame-count>{init.frames}</span><small><Bi text={t.frames} /></small></span>
              <div class="btnrow">
                <button type="button" class="mk dark" data-scroll="more"><Bi text={t.scrollStep} /></button>
                <button type="button" class="mk" data-scroll="reset"><Bi text={t.scrollCancel} /></button>
              </div>
            </div>
          </div>
        </div>
      </article>
      <article class="plate">
        <div class="plate-hd"><span class="pn">C-03</span><span class="nm"><Bi text={t.overlayTitle} /></span></div>
        <div class="plate-bd">
          <p class="desc"><Bi text={t.overlayDesc} /></p>
          <div class="btnrow">
            {captureOverlay.map((b) => (
              <button type="button" class="mk" data-ov={b.id} data-state="idle">
                <span data-for="idle"><Bi text={b.label} /></span><span data-for="done"><Bi text={b.done} /></span>
              </button>
            ))}
          </div>
        </div>
      </article>
      <article class="plate">
        <div class="plate-hd"><span class="pn">C-04</span><span class="nm"><Bi text={t.recTitle} /></span><span class="end"><span class="tag">MOV · MP4 · GIF</span></span></div>
        <div class="plate-bd">
          <p class="desc"><Bi text={t.recDesc} /></p>
          <div class="recrow">
            <span class:list={['recst', !init.recOn && 'off']} data-recst data-state={recState}>
              <span data-for="on"><Bi text={t.recState} /> <span data-clock>{clock}</span></span><span data-for="off"><Bi text={t.recIdle} /></span>
            </span>
            <button type="button" class:list={['mk', init.recOn ? 'dark' : 'sig']} data-rec-toggle data-state={recState}>
              <span data-for="on"><Bi text={t.recStop} /></span><span data-for="off"><Bi text={t.recStart} /></span>
            </button>
          </div>
        </div>
      </article>
    </div>
  </div>
</section>

<script>
  import {
    FRAME_MAX,
    FRAME_SLOTS,
    FRAME_STEP,
    OVERLAY_RESET_MS,
    captureDims,
    captureInitial,
    captureSelections,
    formatClock,
    type CaptureTool,
  } from '../lib/content/studio';

  const root = document.getElementById('capture');
  if (root) {
    const state = { ...captureInitial, ov: null as string | null };
    const $ = (sel: string) => root.querySelector<HTMLElement>(sel);
    const $$ = (sel: string) => Array.from(root.querySelectorAll<HTMLElement>(sel));

    const capsel = $('[data-capsel]');
    const dims = $('[data-dims]');
    const recBadge = $('[data-rec-badge]');
    const tools = $$('[data-tool]');
    const frames = $$('.frames i');
    const frameCount = $('[data-frame-count]');
    const overlay = $$('[data-ov]');
    const clocks = $$('[data-clock]');
    const recst = $('[data-recst]');
    const recBtn = $('[data-rec-toggle]');

    const renderTool = () => {
      const s = captureSelections[state.tool];
      if (capsel) {
        capsel.style.setProperty('--x', String(s.x));
        capsel.style.setProperty('--y', String(s.y));
        capsel.style.setProperty('--w', String(s.w));
        capsel.style.setProperty('--h', String(s.h));
        capsel.classList.toggle('full', state.tool === 'full');
      }
      if (dims) dims.textContent = captureDims(state.tool);
      if (recBadge) recBadge.hidden = state.tool !== 'record';
      tools.forEach((b) => {
        const on = b.dataset.tool === state.tool;
        b.classList.toggle('on', on);
        b.setAttribute('aria-pressed', String(on));
      });
    };

    const renderFrames = () => {
      const shown = Math.min(state.frames, FRAME_SLOTS);
      frames.forEach((f, i) => {
        f.hidden = i >= shown;
        f.classList.toggle('cur', i === shown - 1);
      });
      if (frameCount) frameCount.textContent = String(state.frames);
    };

    const renderClock = () => {
      const text = formatClock(state.recSec);
      clocks.forEach((c) => (c.textContent = text));
    };

    const renderRec = () => {
      const s = state.recOn ? 'on' : 'off';
      if (recst) {
        recst.dataset.state = s;
        recst.classList.toggle('off', !state.recOn);
      }
      if (recBtn) {
        recBtn.dataset.state = s;
        recBtn.classList.toggle('dark', state.recOn);
        recBtn.classList.toggle('sig', !state.recOn);
      }
      renderClock();
    };

    // The clock only runs while recording.
    let tick: number | undefined;
    const syncTimer = () => {
      window.clearInterval(tick);
      tick = state.recOn
        ? window.setInterval(() => {
            state.recSec = (state.recSec + 1) % 3600;
            renderClock();
          }, 1000)
        : undefined;
    };

    tools.forEach((b) =>
      b.addEventListener('click', () => {
        state.tool = b.dataset.tool as CaptureTool;
        renderTool();
      }),
    );

    $('[data-scroll="more"]')?.addEventListener('click', () => {
      state.frames = Math.min(state.frames + FRAME_STEP, FRAME_MAX);
      state.tool = 'scroll';
      renderFrames();
      renderTool();
    });
    $('[data-scroll="reset"]')?.addEventListener('click', () => {
      state.frames = 0;
      renderFrames();
    });

    let ovTimer: number | undefined;
    const renderOverlay = () =>
      overlay.forEach((b) => {
        const on = b.dataset.ov === state.ov;
        b.dataset.state = on ? 'done' : 'idle';
        b.classList.toggle('sig', on);
      });
    overlay.forEach((b) =>
      b.addEventListener('click', () => {
        state.ov = b.dataset.ov ?? null;
        renderOverlay();
        window.clearTimeout(ovTimer);
        ovTimer = window.setTimeout(() => {
          state.ov = null;
          renderOverlay();
        }, OVERLAY_RESET_MS);
      }),
    );

    recBtn?.addEventListener('click', () => {
      // Starting a new recording resets the clock; stopping keeps the final time.
      if (!state.recOn) state.recSec = 0;
      state.recOn = !state.recOn;
      renderRec();
      syncTimer();
    });

    syncTimer();
  }
</script>

<style>
  .cap-grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(12px, 1.6vw, 20px); align-items: stretch; }
  .stage-plate .plate-bd { padding: 14px; }
  .stage { position: relative; aspect-ratio: 16 / 10; border-radius: 10px; overflow: hidden; border: 1px solid var(--rule); }
  @media (min-width: 1081px) {
    .stage-plate { display: flex; flex-direction: column; }
    .stage-plate .plate-bd { flex: 1; display: flex; flex-direction: column; }
    .stage-plate .stage { aspect-ratio: auto; flex: 1; min-height: 360px; }
  }
  .stage .badge { position: absolute; top: 12px; left: 12px; z-index: 3; font: 600 10.5px/1 var(--mono); letter-spacing: 0.08em; text-transform: uppercase; padding: 6px 8px; border-radius: 4px; background: var(--ink); color: var(--paper); }
  .stage .ph-lbl { position: absolute; right: 12px; top: 12px; font: 500 11px/1 var(--mono); color: var(--ink-2); background: var(--bone); padding: 5px 7px; border-radius: 4px; border: 1px solid var(--rule); z-index: 1; }
  .fakewin { position: absolute; left: 10%; top: 13%; width: 54%; height: 64%; border-radius: 8px; background: var(--paper); border: 1px solid var(--rule); box-shadow: 0 16px 30px -18px rgba(20, 24, 38, 0.5); overflow: hidden; }
  .fakewin .bar { height: 22px; display: flex; gap: 5px; align-items: center; padding: 0 8px; border-bottom: 1px solid var(--rule-2); background: var(--bone); }
  .fakewin .bar i { width: 7px; height: 7px; border-radius: 50%; background: var(--steel-2); }
  .fakewin .lines { padding: 12px; display: grid; gap: 7px; }
  .fakewin .lines i { height: 6px; border-radius: 3px; background: var(--rule-2); }
  .fakewin .lines i:nth-child(2) { width: 82%; } .fakewin .lines i:nth-child(3) { width: 64%; } .fakewin .lines i:nth-child(5) { width: 72%; }
  .capsel { position: absolute; z-index: 2; left: calc(100% * var(--x)); top: calc(100% * var(--y)); width: calc(100% * var(--w)); height: calc(100% * var(--h)); border: 1.5px solid var(--sig); box-shadow: 0 0 0 9999px rgba(18, 22, 36, 0.38); transition: left 160ms var(--ease), top 160ms var(--ease), width 160ms var(--ease), height 160ms var(--ease); }
  .capsel .hd { position: absolute; width: 9px; height: 9px; background: var(--paper); border: 1.5px solid var(--sig); border-radius: 2px; }
  .capsel .hA { left: -5px; top: -5px; } .capsel .hB { right: -5px; top: -5px; } .capsel .hC { left: -5px; bottom: -5px; } .capsel .hD { right: -5px; bottom: -5px; }
  .capsel .dims { position: absolute; left: -1px; top: -26px; font: 600 10.5px/1 var(--mono); padding: 5px 6px; background: var(--sig); color: var(--on-sig); border-radius: 3px; white-space: nowrap; }
  .capsel .rec { position: absolute; right: 8px; top: 8px; display: flex; align-items: center; gap: 6px; font: 600 11px/1 var(--mono); color: var(--paper); background: rgba(18, 22, 36, 0.8); padding: 5px 7px; border-radius: 4px; }
  .capsel .rec::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: var(--glow); animation: pulse 1s steps(2, jump-none) infinite; }
  .capsel.full .dims { top: 8px; left: 8px; }
  .toolbar { position: absolute; z-index: 4; left: 50%; bottom: 14px; transform: translateX(-50%); display: flex; gap: 4px; padding: 5px; background: var(--paper); border: 1px solid var(--rule); border-radius: 11px; box-shadow: 0 2px 0 var(--steel), 0 14px 26px -12px rgba(20, 24, 38, 0.5); max-width: calc(100% - 20px); }
  .tool { display: flex; flex-direction: column; align-items: center; gap: 4px; padding: 7px 10px 6px; border: 0; border-radius: 7px; background: transparent; cursor: pointer; font: 500 11px/1 var(--sans); color: var(--ink-2); min-width: 0; white-space: nowrap; transition: background 80ms var(--ease), transform 80ms var(--ease); }
  .tool .g { font: 500 16px/1 var(--mono); color: var(--ink); }
  .tool:hover { background: var(--bone); }
  .tool:active { transform: translateY(1px); }
  .tool.on { background: var(--sig); color: var(--on-sig); box-shadow: 0 2px 0 var(--sig-lo); }
  .tool.on .g { color: var(--on-sig); }
  .cap-side { display: grid; gap: clamp(12px, 1.6vw, 20px); grid-template-rows: auto auto auto; }
  .stitch { display: flex; gap: 12px; align-items: flex-end; }
  .frames { width: 64px; display: flex; flex-direction: column-reverse; gap: 2px; padding: 4px; background: var(--bone-2); border-radius: 6px; border: 1px solid var(--rule); min-height: 92px; justify-content: flex-start; }
  .frames i { height: 6px; border-radius: 2px; background: var(--steel-2); }
  /* The newest frame; every slot is rendered and the unused ones are hidden. */
  .frames i.cur { background: var(--sig); }
  .stitch .smeta { display: grid; gap: 8px; flex: 1; min-width: 0; }
  .count { font: 300 34px/1 var(--mono); letter-spacing: -0.03em; }
  .count small { font: 500 12px var(--mono); letter-spacing: 0.02em; color: var(--ink-2); margin-left: 6px; }
  .btnrow { display: flex; flex-wrap: wrap; gap: 8px; }
  .mk { display: inline-flex; align-items: center; gap: 6px; height: 32px; padding: 0 11px; border-radius: 7px; border: 1px solid var(--rule); background: linear-gradient(180deg, #fff, var(--bone)); box-shadow: 0 2px 0 var(--steel-2); font: 500 12.5px/1 var(--sans); color: var(--ink); cursor: pointer; transition: transform 80ms var(--ease), box-shadow 80ms var(--ease); }
  .mk:active { transform: translateY(2px); box-shadow: 0 0 0 var(--steel-2); }
  .mk.dark { background: var(--ink); color: var(--paper); border-color: var(--ink); box-shadow: 0 2px 0 oklch(0.13 0.016 264); }
  .mk.sig { background: var(--sig); color: var(--on-sig); border-color: var(--sig-lo); box-shadow: 0 2px 0 var(--sig-lo); }
  .recrow { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .recst { display: inline-flex; align-items: center; gap: 8px; font: 600 12.5px/1 var(--mono); padding: 8px 10px; border-radius: 7px; background: var(--lcd); color: var(--lcd-ink); }
  .recst::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: var(--glow); box-shadow: 0 0 6px var(--glow); }
  .recst.off::before { background: oklch(0.4 0.05 262); box-shadow: none; }
  /* One label per state; the language spans inside are hidden globally. */
  [data-state="on"] > [data-for="off"],
  [data-state="off"] > [data-for="on"],
  [data-state="idle"] > [data-for="done"],
  [data-state="done"] > [data-for="idle"] { display: none; }

  @media (max-width: 1080px) {
    .cap-grid { grid-template-columns: minmax(0, 1fr); }
    .cap-side { grid-template-columns: repeat(3, minmax(0, 1fr)); grid-template-rows: none; }
  }
  @media (max-width: 760px) {
    .cap-side { grid-template-columns: minmax(0, 1fr); }
    .stage { aspect-ratio: 4 / 3.4; }
    .tool { padding: 8px 10px; }
    .tool .lb { display: none; }
    .stage .ph-lbl { display: none; }
  }
</style>
