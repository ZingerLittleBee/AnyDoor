---
// Hero copy beside the interactive hotkey unit (#demo).
import Bi from './Bi.astro';
import HotkeyUnit from './HotkeyUnit.astro';
import { hero } from '../lib/content/hero';
import { dmgUrl, REPO } from '../lib/release';
import { latestVersion } from '../lib/version';
---

<section class="hero wrap">
  <div class="hero-grid">
    <div class="hero-copy">
      <div class="spec"><span>{hero.model}</span><span>{hero.rev}{latestVersion}</span><span>{hero.system}</span><span>{hero.arch}</span></div>
      <p class="eyebrow"><Bi text={hero.eyebrow} /></p>
      <h1 class="h1">
        <span class="ln"><Bi text={hero.h1a} /></span>
        <span class="ln"><Bi text={hero.h1b} /></span>
        <span class="ln"><span class="tape"><Bi text={hero.h1c} /></span></span>
      </h1>
      <p class="lede"><Bi text={hero.lede} /></p>
      <div class="cta-row">
        <a class="btn btn-sig" href={dmgUrl}><Bi text={{ zh: hero.ctaPrimary.zh + latestVersion, en: hero.ctaPrimary.en + latestVersion }} /><span class="k">.dmg</span></a>
        <a class="btn" href={REPO} target="_blank" rel="noreferrer"><Bi text={hero.ctaSecondary} /></a>
      </div>
      <ul class="meta">
        {hero.meta.map((m) => <li><Bi text={m} /></li>)}
      </ul>
    </div>

    <HotkeyUnit />
  </div>
</section>

<style>
  .hero { padding-block: clamp(28px, 4.5vw, 64px) clamp(48px, 6vw, 84px); }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 5.2fr) minmax(0, 7.2fr); gap: clamp(28px, 4vw, 60px); align-items: center; }
  .spec { display: flex; flex-wrap: wrap; gap: 6px 16px; font: 500 11px/1.3 var(--mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-2); padding-bottom: 12px; border-bottom: 1px solid var(--rule); margin-bottom: clamp(24px, 3vw, 36px); }
  .spec span + span::before { content: "/"; margin-right: 16px; color: var(--steel-2); }
  .h1 { font-size: clamp(42px, 4.6vw, 68px); line-height: 1.04; letter-spacing: -0.035em; font-weight: 600; }
  :global(html[data-lang="zh"]) .h1 { letter-spacing: -0.015em; line-height: 1.14; }
  .h1 .ln { display: block; }
  .h1 .ln:last-child { margin-top: 0.12em; }
  /* English gives the taped last line more room. */
  :global(html[data-lang="en"]) .h1 .ln:last-child { margin-top: 0.22em; }
  .h1 .tape { display: inline; background: var(--sig); color: var(--on-sig); padding: 0 0.14em; margin-left: -0.04em; border-radius: 0.08em; box-shadow: 0 0.06em 0 var(--sig-lo); -webkit-box-decoration-break: clone; box-decoration-break: clone; }
  .hero .lede { margin-top: 26px; font-size: 17.5px; max-width: 44ch; }
  .cta-row { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 32px; }
  .hero .meta { display: flex; flex-wrap: wrap; gap: 8px 20px; margin-top: 24px; font: 500 12px/1.3 var(--mono); color: var(--ink-2); }
  .hero .meta li { display: flex; align-items: center; gap: 8px; }
  .hero .meta li::before { content: ""; width: 5px; height: 5px; background: var(--ink); border-radius: 1px; }

  @media (prefers-reduced-motion: no-preference) {
    .hero-copy > * { animation: rise 520ms var(--ease) both; }
    .hero-copy > *:nth-child(2) { animation-delay: 50ms; }
    .hero-copy > *:nth-child(3) { animation-delay: 100ms; }
    .hero-copy > *:nth-child(4) { animation-delay: 150ms; }
    .hero-copy > *:nth-child(5) { animation-delay: 200ms; }
    .hero-copy > *:nth-child(6) { animation-delay: 250ms; }
  }

  @media (max-width: 1080px) {
    .hero-grid { grid-template-columns: minmax(0, 1fr); }
    .hero .lede { max-width: 60ch; }
  }
  @media (max-width: 640px) {
    .spec span:last-child { display: none; }
  }
</style>
