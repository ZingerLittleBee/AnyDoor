---
import Bi from './Bi.astro';
import { footer as t } from '../lib/content/end';
import { biAttrs } from '../lib/i18n';
---

<footer class="wrap">
  <div class="foot">
    <div class="foot-top">
      <div>
        <div class="word"><img src="/icon.png" alt="" width="76" height="76" loading="lazy" decoding="async" /><b>AnyDoor</b></div>
        <p class="foot-tag"><Bi text={t.tagline} /></p>
      </div>
      <nav class="foot-links" {...biAttrs({ 'aria-label': t.linksAria })}>
        {t.links.map((l) => <a href={l.href} target="_blank" rel="noreferrer">{l.label}</a>)}
      </nav>
    </div>
    <div class="foot-bot"><span class="lbl">{t.built}</span><span class="lbl">{t.part}</span></div>
  </div>
</footer>

<style>
  .foot { border-top: 2px solid var(--ink); margin-top: clamp(16px, 3vw, 32px); padding-block: 28px 40px; }
  .foot-top { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 24px; }
  .word { display: flex; align-items: center; gap: clamp(12px, 2vw, 22px); }
  .word img { width: clamp(44px, 6vw, 76px); height: clamp(44px, 6vw, 76px); border-radius: 22%; box-shadow: 0 2px 0 var(--steel-2), 0 10px 20px -10px rgba(20, 24, 38, 0.4); }
  .word b { font-size: clamp(44px, 8vw, 112px); line-height: 0.9; letter-spacing: -0.045em; font-weight: 600; }
  .foot-tag { font-size: 17px; color: var(--ink-2); margin-top: 14px; }
  .foot-links { display: flex; flex-wrap: wrap; gap: 8px 22px; font-size: 14px; }
  .foot-links a { text-decoration: none; font-weight: 500; }
  .foot-bot { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 10px; margin-top: 28px; padding-top: 14px; border-top: 1px solid var(--rule); }
</style>
