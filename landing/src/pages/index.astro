---
import { Font } from 'astro:assets';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Why from '../components/Why.astro';
import Workbench from '../components/Workbench.astro';
import Capture from '../components/Capture.astro';
import Settings from '../components/Settings.astro';
import Download from '../components/Download.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
import { RELEASES, REPO } from '../lib/repo';
---

<!doctype html>
<html lang="zh-CN" data-lang="zh">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

    <!-- Resolve language before first paint: avoids a flash of the wrong language
         and gives the document the correct lang for screen readers. -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('anydoor.lang');
          var lang = saved || ((navigator.language || 'zh').toLowerCase().indexOf('zh') === 0 ? 'zh' : 'en');
          var el = document.documentElement;
          el.setAttribute('data-lang', lang);
          el.setAttribute('lang', lang === 'zh' ? 'zh-CN' : 'en');
        } catch (e) {}
      })();
    </script>
    <!-- Without scripting the language stays Chinese and the switcher cannot
         work, so hide it rather than show dead controls. -->
    <noscript><style is:inline>[data-lang-switch] { display: none !important; }</style></noscript>
    <title>AnyDoor — 一颗按键，一扇任意门 · macOS menu bar control center</title>
    <meta name="description" content="AnyDoor is a free, open-source macOS menu bar control center driven by global hotkeys: launch and toggle apps, flip system settings, manage ports and hosts, and run built-in actions — without leaving the keyboard." />
    <link rel="canonical" href="https://anydoor.dev/" />
    <link rel="icon" type="image/png" href="/icon.png" />
    <link rel="apple-touch-icon" href="/icon.png" />

    <!-- Open Graph -->
    <meta property="og:title" content="AnyDoor — macOS menu bar control center" />
    <meta property="og:description" content="Bind any key combination to launch and toggle apps, flip system settings, or run one-off actions — all without leaving the keyboard." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://anydoor.dev/" />
    <meta property="og:site_name" content="AnyDoor" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:locale:alternate" content="en_US" />
    <meta property="og:image" content="https://anydoor.dev/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="AnyDoor — one key, any door. A macOS menu bar control center." />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="AnyDoor — macOS menu bar control center" />
    <meta name="twitter:description" content="One key. Any door. A macOS menu bar control center driven by global hotkeys." />
    <meta name="twitter:image" content="https://anydoor.dev/og.png" />

    <!-- --bone (oklch(0.948 0.007 85)) in sRGB. -->
    <meta name="theme-color" content="#f0ede9" />

    <!-- Self-hosted fonts (astro.config.mjs `fonts`). Preload only the Latin
         faces used above the fold; CJK slices load on demand. -->
    <Font cssVariable="--font-plex-sans" preload={[{ weight: 400, subset: 'latin' }, { weight: 600, subset: 'latin' }]} />
    <Font cssVariable="--font-plex-mono" preload={[{ weight: 500, subset: 'latin' }]} />
    <Font cssVariable="--font-noto-sc" />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: 'AnyDoor',
      applicationCategory: 'UtilitiesApplication',
      operatingSystem: 'macOS 14+',
      url: 'https://anydoor.dev/',
      downloadUrl: RELEASES,
      sameAs: [REPO],
      license: `${REPO}/blob/main/LICENSE`,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    })} />
  </head>
  <body>
    <div class="page">
      <Nav />

      <main id="top">
        <Hero />
        <Why />
        <Workbench />
        <Capture />
        <Settings />
        <Download />
        <FAQ />
      </main>

      <Footer />
    </div>
  </body>
</html>
