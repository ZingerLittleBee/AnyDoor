# The single Xcode pin shared by CI, release builds, and scripts/check-swift.sh.
# Keep it equal to the Xcode developers build against locally and bump it
# deliberately: a compiler bump changes the diagnostic set, and the linked SDK
# version changes runtime appearance on newer macOS. Workflows select the
# runner image (`runs-on: xcode-27`) separately; the setup action fails loudly
# if that image no longer ships this exact build.
XCODE_APP=/Applications/Xcode_27.0.app
XCODE_BUILD=27A266a
